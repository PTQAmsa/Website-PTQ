# ============================================================
# Supabase
# ============================================================
# Dapatkan dari: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ============================================================
# Google Apps Script (Email Notifications)
# ============================================================
# URL Google Apps Script yang sudah di-deploy sebagai Web App.
# Digunakan untuk mengirim notifikasi email ke admin dan user.
# Sudah dipakai di fitur Tes Multiple Intelligence.
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Email admin yang menerima notifikasi pendaftaran baru
ADMIN_EMAIL=admin@pesantren.com

# ============================================================
# Midtrans Payment Gateway
# ============================================================
# Dapatkan dari: https://dashboard.midtrans.com → Settings → Access Keys
# Untuk testing, gunakan Sandbox: https://dashboard.sandbox.midtrans.com

# Server Key (RAHASIA — jangan expose ke client/browser)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx

# Client Key (boleh dipakai di frontend jika diperlukan)
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx

# Set ke "false" untuk Sandbox, "true" untuk Production
MIDTRANS_IS_PRODUCTION=false

# ============================================================
# Site URL
# ============================================================
# URL publik website, digunakan untuk callback dan redirect URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# Admin Dashboard
# ============================================================
# Password sederhana untuk melindungi halaman admin
# (Tidak perlu sistem auth penuh untuk Phase 1)
ADMIN_PASSWORD=ganti-dengan-password-aman

# ============================================================
# Cron Job Security
# ============================================================
# Secret token untuk verify Vercel Cron Job requests
# Digunakan untuk endpoint keep-alive Supabase database
# Generate dengan: openssl rand -base64 32
CRON_SECRET=your-random-secret-string-here

